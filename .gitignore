# Xcode project is generated by XcodeGen (project.yml) and is not tracked.
*.xcodeproj/
*.xcworkspace/
Project.xcworkspace/

# Build products / intermediates
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip
*.hmap
*.app

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager / SwiftPM caches
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store
._*

# Local overrides
*.local.xcconfig
Local.xcconfig

# Reference material fetched from third-party (GPL) sources during research.
# Kept on disk for development only, never distributed with this project.
_research/

# Local run artifacts
*.log
/artifacts/
